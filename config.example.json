{
  "server_url": "wss://ops.example.com/ws",
  "token": "REPLACE_WITH_LONG_RANDOM_STRING",
  "client_id": "tomcat-helper-01",
  "tomcat_home": "C:\\tomcat",
  "jdk_home": "C:\\jdk-17",
  "log_dir": "C:\\tomcat\\logs",
  "allowed_dirs": [
    "C:\\tomcat",
    "C:\\tomcat\\logs",
    "C:\\tomcat\\webapps",
    "C:\\deploy"
  ],
  "command_timeout": 30,
  "max_output_size": 1048576,
  "reconnect_interval": 5,
  "heartbeat_interval": 30,
  "heartbeat_timeout": 90,
  "log_file": "helper.log",
  "insecure_skip_verify": false,
  "service_name": "Tomcat10",

  "esb": {
    "host": "10.0.0.5",
    "port": 3306,
    "user": "esb_ro",
    "password": "REPLACE_ME",
    "database": "esb",
    "enabled": true,
    "forbid_cmd": true
  },

  "erp": {
    "type": "oracle",
    "host": "10.0.0.6",
    "port": 1521,
    "user": "erp_ro",
    "password": "REPLACE_ME",
    "database": "ORCL",
    "encrypt": "disable",
    "tls_min": "1.0",
    "trust_cert": true,
    "hostname_in_cert": "db.internal",
    "enabled": true,
    "forbid_cmd": true
  }
}
